<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd template for krakoad. Copy to ~/Library/LaunchAgents/com.krakoa.krakoad.plist,
     fill in the paths, then: launchctl load ~/Library/LaunchAgents/com.krakoa.krakoad.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.krakoa.krakoad</string>
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/krakoad</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KRAKOA_WORKSPACES</key><string>/PATH/TO/workspace-dir</string>
    <key>KRAKOA_DB</key><string>/Users/YOU/.krakoa/krakoa.db</string>
    <key>KRAKOA_DATA_DIR</key><string>/Users/YOU/.krakoa/data</string>
    <key>KRAKOA_HTTP_ADDR</key><string>127.0.0.1:7770</string>
    <key>KRAKOA_NIFFTY_URL</key><string>http://127.0.0.1:7777</string>
    <key>KRAKOA_NIFFTY_TO</key><string>you@example.com</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/krakoad.log</string>
  <key>StandardErrorPath</key><string>/tmp/krakoad.log</string>
</dict>
</plist>
